# Runtime image built from a verified ZAKS Drive release binary (see docs/cli.md).
# Build context: the unpacked release directory (zaks-drive-server, spool/).
#   docker build -f deploy/Dockerfile.release --build-arg VERSION=<version> -t zaks-drive:<version> <dir>
# To pin the base image, pass --build-arg BASE_IMAGE=gcr.io/distroless/static-debian12@sha256:<digest>.
ARG BASE_IMAGE=gcr.io/distroless/static-debian12:nonroot
FROM ${BASE_IMAGE}
ARG VERSION=dev
ARG REVISION=unknown
LABEL org.opencontainers.image.title="ZAKS Drive" \
      org.opencontainers.image.description="Self-hosted content gateway connecting SAP S/4HANA and enterprise applications to SharePoint Online and OneDrive for Business." \
      org.opencontainers.image.source="https://github.com/Lamiv/zaks-drive" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.licenses="MIT"
# /zaks-drive and /adapter are compatibility names of the server binary; see branding-and-compatibility.md.
COPY zaks-drive-server /zaks-drive-server
COPY zaks-drive-server /zaks-drive
COPY zaks-drive-server /adapter
COPY --chown=65532:65532 spool /var/spool/adapter
# State directory (repository definitions, secrets, local data): mount a volume here. The image copy of
# the spool folder gives it the right owner; the volume inherits that on first use.
COPY --chown=65532:65532 spool /var/lib/zaks-drive
EXPOSE 8080 8090 9090
USER nonroot:nonroot
ENTRYPOINT ["/zaks-drive-server"]
CMD ["-config", "/etc/adapter/config.yaml"]
